# Copy to .env (next to docker-compose.yml) and fill in the keys.
# .env is git-ignored. NAPCAT_ACCESS_TOKEN must equal the token in
# data/napcat-docker/config/onebot11.json.

# Model credential — inherited by the Harness process; it outranks
# $DSH_HOME/.credentials.yaml.
DEEPSEEK_API_KEY=

# Host port that serves the Harness UI (published to dsh's 3080).
LUOYU_PORT=3090

# Host directory mounted into the container as /workspace — the luoyu-memory
# repository (AGENTS.md with the persona, per-person memory files).
LUOYU_WORKSPACE_HOST=D:/tools/luoyu-memory

# NapCat WebUI (QR login) — published port and login token.
NAPCAT_WEBUI_PORT=6099
NAPCAT_WEBUI_TOKEN=

# OneBot token shared with the NapCat container (see its onebot11.json).
NAPCAT_ACCESS_TOKEN=

# NapCat image and its host-side state directories.
NAPCAT_IMAGE=mlikiowa/napcat-docker:v4.18.41
NAPCAT_CONFIG_HOST=../../data/napcat-docker/config
NAPCAT_QQ_HOST=../../data/napcat-docker/qq

# Optional overrides.
# DSH_VERSION=0.2.1-rc.2
# PNPM_VERSION=12.15.0
# LUOYU_IMAGE_TAG=local
# TZ=Asia/Shanghai
# Space-separated extra authorities the browser-trust fence accepts, e.g. a
# LAN address published through another proxy: "my-host.lan:3090".
# DSH_EXTRA_TRUSTED_HOSTS=
