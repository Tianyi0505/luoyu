# Copy to .env (next to docker-compose.yml) and fill in the key.
# .env is git-ignored.

# Model credential — inherited by the Harness process; it outranks
# $DSH_HOME/.credentials.yaml.
DEEPSEEK_API_KEY=

# Host port that serves the Harness UI.
LUOYU_PORT=3090

# Host directory mounted into the container as /workspace — the luoyu-memory
# repository (persona, memory Markdown, session workspace).
LUOYU_WORKSPACE_HOST=../../workspace

# 0 = do not start Xvfb (only useful if the container gets a display some
# other way; the QQ client cannot start without one).
LUOYU_XVFB=1

# Optional overrides.
# DSH_VERSION=0.2.1-rc.2
# PNPM_VERSION=12.15.0
# LUOYU_IMAGE_TAG=local
# TZ=Asia/Shanghai
# Space-separated extra authorities the browser-trust fence accepts, e.g. a
# LAN address published through another proxy: "my-host.lan:3090".
# DSH_EXTRA_TRUSTED_HOSTS=
